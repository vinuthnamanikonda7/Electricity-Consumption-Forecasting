# MySQL Database Configuration
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=electricity_forecasting
MYSQL_SSL_MODE=REQUIRED
MYSQL_URL=your_mysql_connection_url

# JSON Web Token Secret
JWT_SECRET=replace_with_a_strong_random_secret

# Client URL(s) allowed by CORS. Use a comma-separated list for local + production origins.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,https://electricity-consumption-forecasting.onrender.com

# Brevo Transactional Email API
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email
BREVO_SENDER_NAME=Electricity Forecasting System
